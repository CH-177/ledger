<ContentDialog
    x:Class="Ledger.App.Views.Dialogs.GoalEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsNotSaving(ViewModel.IsSaving), Mode=OneWay}"
    PrimaryButtonClick="OnSaveClick">

    <ScrollViewer Width="420" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,0,12,0">
            <TextBox x:Name="NameBox" Header="Name" MaxLength="100" PlaceholderText="e.g. MacBook"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Header="Target amount" PlaceholderText="$0.00" InputScope="CurrencyAmount"
                     Text="{x:Bind ViewModel.TargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Spacing="6">
                <CheckBox Content="Has a target date" IsChecked="{x:Bind ViewModel.HasTargetDate, Mode=TwoWay}" />
                <CalendarDatePicker Header="Target date" HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind ViewModel.HasTargetDate, Mode=OneWay}"
                                    Date="{x:Bind ViewModel.TargetDate, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox Content="This is a sinking fund" IsChecked="{x:Bind ViewModel.IsSinkingFund, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                           Text="Money set aside for a cost you know is coming, like car repairs, gifts or a yearly bill. It's kept out of 'Free to spend', and spending can be paid from it." />
            </StackPanel>

            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsSinkingFund, Mode=OneWay}">
                <TextBox Header="Set aside each month (optional)" PlaceholderText="$0.00" InputScope="CurrencyAmount"
                         Text="{x:Bind ViewModel.MonthlyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Header="Pays for (optional)" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.CategoryOptions}" DisplayMemberPath="Label"
                          SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}" />
            </StackPanel>

            <RadioButtons Header="How is progress tracked?" SelectedIndex="{x:Bind ViewModel.TrackingIndex, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.IsNotFund, Mode=OneWay}">
                <x:String>I'll add money as I save</x:String>
                <x:String>Use an account's balance (a dedicated savings account)</x:String>
            </RadioButtons>

            <TextBox Header="Already saved (optional)" PlaceholderText="$0.00" InputScope="CurrencyAmount"
                     Visibility="{x:Bind ViewModel.IsManual, Mode=OneWay}"
                     Text="{x:Bind ViewModel.StartingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Header="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.AccountOptions}" DisplayMemberPath="Label"
                      SelectedIndex="{x:Bind ViewModel.AccountIndex, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind ViewModel.Preview, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource LedgerNegativeBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}"
                           Foreground="{ThemeResource LedgerNegativeBrush}" MaxWidth="370" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
