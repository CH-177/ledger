<ContentDialog
    x:Class="Ledger.App.Views.Dialogs.ShiftEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">

    <StackPanel Width="380" Spacing="14">
        <ComboBox Header="Job" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.HasSeveralJobs}"
                  ItemsSource="{x:Bind ViewModel.JobOptions}" DisplayMemberPath="Label"
                  SelectedIndex="{x:Bind ViewModel.JobIndex, Mode=TwoWay}" />
        <CalendarDatePicker Header="Date" HorizontalAlignment="Stretch" Date="{x:Bind ViewModel.Date, Mode=TwoWay}" />

        <RadioButtons MaxColumns="2" AutomationProperties.Name="How to enter the shift"
                      SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
            <x:String>Shift length</x:String>
            <x:String>Start and end times</x:String>
        </RadioButtons>

        <TextBox x:Name="HoursBox" Header="Shift length (hours, as scheduled)" PlaceholderText="e.g. 6" InputScope="Number"
                 Visibility="{x:Bind ViewModel.UsesHours, Mode=OneWay}"
                 Text="{x:Bind ViewModel.HoursText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.UsesTimes, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TimePicker Header="Start" HorizontalAlignment="Stretch" MinuteIncrement="5" Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" />
            <TimePicker Grid.Column="1" Header="End" HorizontalAlignment="Stretch" MinuteIncrement="5" Time="{x:Bind ViewModel.EndTime, Mode=TwoWay}" />
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.PaidPreview, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}"
                   Foreground="{ThemeResource LedgerAccentBrush}" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Different unpaid break this shift:" IsChecked="{x:Bind ViewModel.HasBreakOverride, Mode=TwoWay}" VerticalAlignment="Center" />
            <TextBox PlaceholderText="0" InputScope="Number" Width="72" AutomationProperties.Name="Unpaid break for this shift in minutes"
                     IsEnabled="{x:Bind ViewModel.HasBreakOverride, Mode=OneWay}"
                     Text="{x:Bind ViewModel.BreakText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="min" Style="{StaticResource LedgerCaptionStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox Content="I worked this shift" IsChecked="{x:Bind ViewModel.IsWorked, Mode=TwoWay}" />
        <TextBox Header="Note (optional)" PlaceholderText="e.g. Training" MaxLength="200"
                 Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource LedgerNegativeBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}"
                       Foreground="{ThemeResource LedgerNegativeBrush}" MaxWidth="340" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
