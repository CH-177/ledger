<ContentDialog
    x:Class="Ledger.App.Views.Dialogs.TransactionEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Ledger.Core.Services"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Save"
    SecondaryButtonText="{x:Bind SecondaryText}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsNotSaving(ViewModel.IsSaving), Mode=OneWay}"
    IsSecondaryButtonEnabled="{x:Bind IsNotSaving(ViewModel.IsSaving), Mode=OneWay}"
    PrimaryButtonClick="OnSaveClick"
    SecondaryButtonClick="OnSaveAndAddClick">

    <ScrollViewer Width="420" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,0,12,0">
            <InfoBar IsOpen="{x:Bind ViewModel.HasHint}" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.Hint}" />
            <RadioButtons x:Name="TypeButtons" MaxColumns="2" AutomationProperties.Name="Kind of transaction"
                          SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}">
                <x:String>Spending</x:String>
                <x:String>Income</x:String>
                <x:String>Transfer</x:String>
                <x:String>Refund</x:String>
            </RadioButtons>
            <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.IsRefund, Mode=OneWay}"
                       Text="Money back for something you bought. It lowers spending in its category and never counts as income." />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AmountBox" Header="Amount" PlaceholderText="$0.00" InputScope="CurrencyAmount"
                         Text="{x:Bind ViewModel.AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CalendarDatePicker Grid.Column="1" Header="Date" HorizontalAlignment="Stretch"
                                    Date="{x:Bind ViewModel.Date, Mode=TwoWay}" />
            </Grid>

            <AutoSuggestBox x:Name="PayeeBox"
                            Header="{x:Bind ViewModel.PayeeLabel, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.PayeePlaceholder, Mode=OneWay}"
                            TextMemberPath="Payee"
                            Text="{x:Bind ViewModel.Payee, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.PayeeSuggestions}"
                            TextChanged="OnPayeeTextChanged" LostFocus="OnPayeeLostFocus"
                            SuggestionChosen="OnPayeeChosen">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="core:PayeeSuggestion">
                        <TextBlock Text="{x:Bind Payee}" />
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-8,0,0" Visibility="{x:Bind ViewModel.HasHabitHint, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.HabitHint, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}" VerticalAlignment="Center" />
                <HyperlinkButton Content="{x:Bind ViewModel.UseAmountText, Mode=OneWay}" Padding="4,0" Click="OnUseAmountClick"
                                 Visibility="{x:Bind ViewModel.HasUseAmount, Mode=OneWay}" />
            </StackPanel>

            <ComboBox Header="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.AccountOptions}" DisplayMemberPath="Label"
                      SelectedIndex="{x:Bind ViewModel.AccountIndex, Mode=TwoWay}" />

            <ComboBox Header="{x:Bind ViewModel.ToAccountLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.IsTransfer, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.ToAccountOptions}" DisplayMemberPath="Label"
                      SelectedIndex="{x:Bind ViewModel.ToAccountIndex, Mode=TwoWay}" />

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsOutside, Mode=OneWay}">
                <RadioButtons MaxColumns="2" AutomationProperties.Name="Which way the money went"
                              SelectedIndex="{x:Bind ViewModel.OutsideDirectionIndex, Mode=TwoWay}">
                    <x:String>Money out to them</x:String>
                    <x:String>Money in from them</x:String>
                </RadioButtons>
                <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                           Text="For money moved with someone else's account, like a family member's. It changes your balance but isn't income or spending." />
            </StackPanel>

            <ComboBox Header="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.CategoryOptions}" DisplayMemberPath="Label"
                      SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}" />

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowFunds, Mode=OneWay}">
                <ComboBox Header="Pay from a sinking fund" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.FundOptions}" DisplayMemberPath="Label"
                          SelectedIndex="{x:Bind ViewModel.FundIndex, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                           Text="Uses money you set aside for this. It still counts as spending in its category." />
            </StackPanel>

            <AutoSuggestBox Header="Note (optional)" Text="{x:Bind ViewModel.Memo, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.NoteSuggestions}"
                            TextChanged="OnNoteTextChanged" SuggestionChosen="OnNoteChosen" />

            <CheckBox Content="Pending (not yet cleared by the bank)" IsChecked="{x:Bind ViewModel.IsPending, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource LedgerNegativeBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}"
                           Foreground="{ThemeResource LedgerNegativeBrush}" MaxWidth="380"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
