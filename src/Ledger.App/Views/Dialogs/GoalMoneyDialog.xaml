<ContentDialog
    x:Class="Ledger.App.Views.Dialogs.GoalMoneyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsNotSaving(ViewModel.IsSaving), Mode=OneWay}"
    PrimaryButtonClick="OnSaveClick">

    <StackPanel Width="360" Spacing="14">
        <TextBlock Text="{x:Bind ViewModel.CurrentText}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" />
        <RadioButtons MaxColumns="2" AutomationProperties.Name="Add or take out" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
            <x:String>Add money</x:String>
            <x:String>Take money out</x:String>
        </RadioButtons>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AmountBox" Header="Amount" PlaceholderText="$0.00" InputScope="CurrencyAmount"
                     Text="{x:Bind ViewModel.AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CalendarDatePicker Grid.Column="1" Header="Date" HorizontalAlignment="Stretch" Date="{x:Bind ViewModel.Date, Mode=TwoWay}" />
        </Grid>
        <TextBox Header="Note (optional)" MaxLength="200" Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource LedgerNegativeBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}"
                       Foreground="{ThemeResource LedgerNegativeBrush}" MaxWidth="320" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
