<Page
    x:Class="Ledger.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ledger.App.Controls"
    xmlns:vm="using:Ledger.App.ViewModels">

    <!-- Numbers first, with plain bars for comparison: no chart library, no rainbow colours (brief §20, §27). -->
    <Page.Resources>
        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:CategoryShareViewModel">
            <Grid Padding="0,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerBodyStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Value="{x:Bind Percent}" Maximum="100" MinHeight="8" CornerRadius="4" VerticalAlignment="Center"
                             AutomationProperties.Name="{x:Bind ShareText}" />
                <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" Style="{StaticResource LedgerBodyStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind ShareText}" Style="{StaticResource LedgerCaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowTemplate" x:DataType="vm:MonthFlowViewModel">
            <Grid Padding="0,8" ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.RowSpan="2" Text="{x:Bind MonthText}" Style="{StaticResource LedgerBodyStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar Grid.Column="1" Value="{x:Bind IncomeBar}" Maximum="100" MinHeight="8" CornerRadius="4" VerticalAlignment="Center"
                             Foreground="{ThemeResource LedgerPositiveBrush}" AutomationProperties.Name="{x:Bind IncomeText}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{x:Bind SpendingBar}" Maximum="100" MinHeight="8" CornerRadius="4" VerticalAlignment="Center"
                             Foreground="{ThemeResource LedgerTextSecondaryBrush}" AutomationProperties.Name="{x:Bind SpendingText}" />
                <TextBlock Grid.Column="2" Text="{x:Bind IncomeText}" Style="{StaticResource LedgerCaptionStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind SpendingText}" Style="{StaticResource LedgerCaptionStyle}" HorizontalAlignment="Right" />
                <Grid Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind NetText}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Visibility="{x:Bind IsNetNotNegative}" />
                    <TextBlock Text="{x:Bind NetText}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{ThemeResource LedgerNegativeBrush}" Visibility="{x:Bind IsNetNegative}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WorthTemplate" x:DataType="vm:NetWorthPointViewModel">
            <Grid Padding="0,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DateText}" Style="{StaticResource LedgerBodyStyle}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Value="{x:Bind Bar}" Maximum="100" MinHeight="8" CornerRadius="4" VerticalAlignment="Center"
                             AutomationProperties.Name="{x:Bind AmountText}" />
                <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" Style="{StaticResource LedgerBodyStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BalanceTemplate" x:DataType="vm:AccountBalanceViewModel">
            <Grid Padding="0,4">
                <StackPanel>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerBodyStyle}" />
                    <TextBlock Text="{x:Bind TypeText}" Style="{StaticResource LedgerCaptionStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind BalanceText}" Style="{StaticResource LedgerBodyStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- The page column fills the width up to LedgerContentMaxWidth, left-aligned. The cap lives on
         the Grid column: a MaxWidth element directly inside a ScrollViewer is mis-centred on wide windows. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource LedgerContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource LedgerPageContentStyle}">
                <TextBlock Text="Reports" Style="{StaticResource LedgerPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         IsClosable="False" Severity="Warning" Title="Ledger couldn't load your reports. Your data hasn't been changed.">
                    <InfoBar.ActionButton>
                        <Button Content="Try Again" Command="{x:Bind ViewModel.LoadCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <controls:EmptyState Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" Glyph="&#xE9D2;"
                                     Title="Nothing to report yet."
                                     Message="Add an account and some transactions, and reports on your spending, cash flow and net worth appear here." />

                <StackPanel Spacing="28" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                    <!-- Where did my money go? -->
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Spending by category" Style="{StaticResource LedgerSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{x:Bind ViewModel.SpendingTotalText, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.PreviousMonthCommand}" AutomationProperties.Name="Previous month"
                                        ToolTipService.ToolTip="Previous month" Padding="10,8">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.MonthText, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="130" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <Button Command="{x:Bind ViewModel.NextMonthCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                        AutomationProperties.Name="Next month" ToolTipService.ToolTip="Next month" Padding="10,8">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource LedgerCardStyle}" Padding="20,10" Visibility="{x:Bind ViewModel.HasCategories, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Categories}" ItemTemplate="{StaticResource CategoryTemplate}" IsTabStop="False" />
                        </Border>
                    </StackPanel>

                    <!-- Income vs spending, month by month -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Cash flow" Style="{StaticResource LedgerSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind ViewModel.CashFlowSummary, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource LedgerCardStyle}" Padding="20,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="146,0,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="14" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource LedgerPositiveBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Income (top)" Style="{StaticResource LedgerCaptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="14" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource LedgerTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Spending (bottom)" Style="{StaticResource LedgerCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Net on the right" Style="{StaticResource LedgerCaptionStyle}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CashFlow}" ItemTemplate="{StaticResource FlowTemplate}" IsTabStop="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Net worth -->
                    <controls:EqualColumnsPanel Spacing="16" MinColumnWidth="360" MaxColumns="2">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Net worth" Style="{StaticResource LedgerSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="What you have minus what you owe. Transfers never change it." Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Style="{StaticResource LedgerCardStyle}" Padding="20,10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.NetWorth}" ItemTemplate="{StaticResource WorthTemplate}" IsTabStop="False" />
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Account balances" Style="{StaticResource LedgerSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="Actual balances today." Style="{StaticResource LedgerCaptionStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource LedgerCardStyle}" Padding="20,10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Balances}" ItemTemplate="{StaticResource BalanceTemplate}" IsTabStop="False" />
                            </Border>
                        </StackPanel>
                    </controls:EqualColumnsPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
