<Page
    x:Class="Ledger.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ledger.App.Controls"
    xmlns:vm="using:Ledger.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="AccountRowTemplate" x:DataType="vm:AccountRowViewModel">
            <Grid Padding="4,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource LedgerBlueSoftBrush}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource LedgerAccentBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock Text="{x:Bind BalanceText}" Style="{StaticResource LedgerBodyStyle}" FontSize="16"
                               FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                    <TextBlock Text="Overdrawn" Style="{StaticResource LedgerCaptionStyle}" HorizontalAlignment="Right"
                               Foreground="{ThemeResource LedgerNegativeBrush}" Visibility="{x:Bind IsOverdrawn}" />
                </StackPanel>

                <Button Grid.Column="3" VerticalAlignment="Center" Padding="8" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{x:Bind MoreOptionsName}" ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="View transactions" Tag="{x:Bind}" Click="OnViewTransactionsClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Reconcile with a statement…" Tag="{x:Bind}" Click="OnReconcileClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Archive" Tag="{x:Bind}" Click="OnArchiveClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArchivedRowTemplate" x:DataType="vm:AccountRowViewModel">
            <Grid Padding="4,10" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerBodyStyle}" TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="NoWrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind BalanceText}" Style="{StaticResource LedgerSecondaryStyle}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button Grid.Column="2" Content="Restore" Tag="{x:Bind}" Click="OnRestoreClick" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- The page column fills the width up to LedgerContentMaxWidth, left-aligned. The cap lives on
         the Grid column: a MaxWidth element directly inside a ScrollViewer is mis-centred on wide windows. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource LedgerContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Style="{StaticResource LedgerPageContentStyle}">
            <Grid>
                <TextBlock Text="Accounts" Style="{StaticResource LedgerPageTitleStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Add account"
                        Command="{x:Bind AddAccountCommand}" Visibility="{x:Bind ViewModel.HasActiveAccounts, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add account" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Try Again" Command="{x:Bind ViewModel.LoadCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:EmptyState
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                Glyph="&#xE825;"
                Title="No accounts yet."
                Message="Add the places your money lives: checking, savings, cash or a credit card."
                ActionText="Add account"
                Command="{x:Bind AddAccountCommand}" />

            <!-- Net worth: actual figures only. -->
            <Border Style="{StaticResource LedgerCardStyle}" Visibility="{x:Bind ViewModel.HasActiveAccounts, Mode=OneWay}">
                <Grid ColumnSpacing="32" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="NET WORTH  ·  ACTUAL" Style="{StaticResource LedgerEyebrowStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NetWorthText, Mode=OneWay}" Style="{StaticResource LedgerDisplayAmountStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                        <TextBlock Text="ASSETS" Style="{StaticResource LedgerEyebrowStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AssetsText, Mode=OneWay}" Style="{StaticResource LedgerSectionTitleStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                        <TextBlock Text="OWED" Style="{StaticResource LedgerEyebrowStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LiabilitiesText, Mode=OneWay}" Style="{StaticResource LedgerSectionTitleStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource LedgerCardStyle}" Padding="12,8"
                    Visibility="{x:Bind ViewModel.HasActiveAccounts, Mode=OneWay}">
                <ListView ItemsSource="{x:Bind ViewModel.ActiveAccounts}"
                          ItemTemplate="{StaticResource AccountRowTemplate}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnAccountClick"
                          AutomationProperties.Name="Accounts" />
            </Border>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="Archived accounts"
                      Visibility="{x:Bind ViewModel.HasArchivedAccounts, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource LedgerCaptionStyle}"
                               Text="Archived accounts are hidden from everyday views. Their history is kept, and any balance still counts toward net worth." />
                    <ListView ItemsSource="{x:Bind ViewModel.ArchivedAccounts}"
                              ItemTemplate="{StaticResource ArchivedRowTemplate}"
                              SelectionMode="None"
                              AutomationProperties.Name="Archived accounts" />
                </StackPanel>
            </Expander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
