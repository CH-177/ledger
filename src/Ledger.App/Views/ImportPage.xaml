<Page
    x:Class="Ledger.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ledger.App.ViewModels">

    <Page.Resources>
        <!-- Line 1: what the bank file says. Line 2: what Ledger will save (editable). -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ImportRowViewModel">
            <Grid Padding="4,10" RowSpacing="8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox Grid.RowSpan="2" MinWidth="0" VerticalAlignment="Top" IsChecked="{x:Bind Include, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind IncludeName}" />
                <Grid Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DateText}" Style="{StaticResource LedgerBodyStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind AmountText}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource LedgerPositiveBrush}" Visibility="{x:Bind IsMoneyIn}" />
                        <TextBlock Text="{x:Bind AmountText}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Visibility="{x:Bind IsMoneyOut}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource LedgerCaptionStyle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Description}" />
                        <Border Visibility="{x:Bind IsDuplicate}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,1"
                                Background="{ThemeResource LedgerPeachSoftBrush}">
                            <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource LedgerCaptionStyle}" Foreground="{ThemeResource LedgerTextPrimaryBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border Visibility="{x:Bind NeedsAttention}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,1"
                                Background="{ThemeResource LedgerBlueSoftBrush}">
                            <TextBlock Text="{x:Bind BadgeText}" Style="{StaticResource LedgerCaptionStyle}" Foreground="{ThemeResource LedgerTextPrimaryBrush}" TextWrapping="Wrap" />
                        </Border>
                        <CheckBox Content="{x:Bind BillText}" IsChecked="{x:Bind LinkBill, Mode=TwoWay}" MinWidth="0" Padding="8,0,0,0"
                                  Visibility="{x:Bind HasBill, Mode=OneWay}"
                                  ToolTipService.ToolTip="The bill shows as recorded with this payment instead of needing to be recorded" />
                        <CheckBox Content="{x:Bind PaycheckText}" IsChecked="{x:Bind LinkPaycheck, Mode=TwoWay}" MinWidth="0" Padding="8,0,0,0"
                                  Visibility="{x:Bind HasPaycheck, Mode=OneWay}"
                                  ToolTipService.ToolTip="The paycheck shows as recorded with this deposit, and its estimate stops counting in the forecast" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind Payee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Payee" MaxLength="200"
                             AutomationProperties.Name="Payee" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind TypeOptions}"
                              SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}" AutomationProperties.Name="Kind" />
                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" Visibility="{x:Bind IsNotTransfer, Mode=OneWay}"
                              ItemsSource="{x:Bind CategoryOptions, Mode=OneWay}" DisplayMemberPath="Label"
                              SelectedIndex="{x:Bind CategoryIndex, Mode=TwoWay}" AutomationProperties.Name="Category" />
                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" Visibility="{x:Bind IsTransfer, Mode=OneWay}"
                              ItemsSource="{x:Bind TransferOptions}" DisplayMemberPath="Label"
                              SelectedIndex="{x:Bind TransferIndex, Mode=TwoWay}" AutomationProperties.Name="Other account" />
                    <CheckBox Grid.Column="3" Content="Remember" IsChecked="{x:Bind Remember, Mode=TwoWay}" MinWidth="0"
                              ToolTipService.ToolTip="Use this payee and category for this description in future imports" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- The page column fills the width up to LedgerContentMaxWidth, left-aligned. The cap lives on
         the Grid column: a MaxWidth element directly inside a ScrollViewer is mis-centred on wide windows. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource LedgerContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource LedgerPageContentStyle}">
                <StackPanel Spacing="2">
                    <HyperlinkButton Content="‹ Transactions" Padding="0" Click="OnBackClick" />
                    <TextBlock Text="Import from your bank" Style="{StaticResource LedgerPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                         IsClosable="False" Severity="Success" Message="{x:Bind ViewModel.ResultText, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="View transactions" Click="OnViewTransactionsClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar IsOpen="{x:Bind ViewModel.HasBankBalance, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasBankBalance, Mode=OneWay}"
                         IsClosable="False" Severity="Informational" Title="Bank balance" Message="{x:Bind ViewModel.BankBalanceText, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Use the bank's balance" Click="OnMatchBankClick" Visibility="{x:Bind ViewModel.CanMatchBank, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Before a file is chosen -->
                <Border Style="{StaticResource LedgerCardStyle}" Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource LedgerBodyStyle}" TextWrapping="Wrap"
                                   Text="Download your transactions from your bank's website and open the file here. Ledger reads CSV and QFX files, shows you every row, spots ones already in Ledger, and saves nothing until you choose Import." />
                        <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                                   Text="Most banks have a Download or Export button on an account's transaction list. Choose QFX (Quicken) or OFX if offered, otherwise CSV. The file stays on this PC; Ledger only reads it." />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Choose a file…" Click="OnChooseFileClick" />
                    </StackPanel>
                </Border>

                <!-- A file is open -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}">
                    <Border Style="{StaticResource LedgerCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.FileTitle, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Choose another file…" Click="OnChooseFileClick" />
                                <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" />
                            </Grid>
                            <ComboBox Header="Import into" MinWidth="260" ItemsSource="{x:Bind ViewModel.AccountOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{x:Bind ViewModel.AccountIndex, Mode=TwoWay}" PlaceholderText="Choose an account" />

                            <Expander Header="Columns in this file" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.IsCsv, Mode=OneWay}" IsExpanded="False">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                                               Text="Ledger guessed these from the file's headers. Change any that are wrong; they're remembered for this account. Use Amount for one signed column, or Debit and Credit for two." />
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox Header="Date" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.DateIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" Header="Description" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.DescriptionIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="2" Header="Amount" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.AmountIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="1" Header="Debit (money out)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.DebitIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Header="Credit (money in)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.CreditIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="1" Grid.Column="2" Header="Memo (optional)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.MemoIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="2" Header="Bank reference (optional)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.ReferenceIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Header="Balance (optional)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.HeaderOptions}" SelectedIndex="{x:Bind ViewModel.BalanceIndex, Mode=TwoWay}" />
                                        <CheckBox Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.InvertSign, Mode=TwoWay}"
                                                  Content="Money out shows as positive (some card exports)" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                        <TextBlock Text="Lines Ledger couldn't use" Style="{StaticResource LedgerEyebrowStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Problems}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource LedgerBodyStyle}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                            <HyperlinkButton Content="Tick all" Click="OnTickAllClick" />
                            <HyperlinkButton Content="Untick all" Click="OnUntickAllClick" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}" Click="OnImportClick" />
                    </Grid>

                    <Border Style="{StaticResource LedgerCardStyle}" Padding="12,4" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" />
                    </Border>
                </StackPanel>

                <!-- Past imports, each undoable -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                    <TextBlock Text="Recent imports" Style="{StaticResource LedgerSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource LedgerCardStyle}" Padding="20,8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Recent}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentImportViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource LedgerBodyStyle}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LedgerCaptionStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Undo" Tag="{x:Bind}" Visibility="{x:Bind CanUndo}" Click="OnUndoClick"
                                                AutomationProperties.Name="{x:Bind UndoName}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
