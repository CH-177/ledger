<Page
    x:Class="Ledger.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The page column fills the width up to LedgerContentMaxWidth, left-aligned. The cap lives on
         the Grid column: a MaxWidth element directly inside a ScrollViewer is mis-centred on wide windows. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource LedgerContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Style="{StaticResource LedgerPageContentStyle}">
            <TextBlock Text="Settings" Style="{StaticResource LedgerPageTitleStyle}"
                       AutomationProperties.HeadingLevel="Level1" />

            <StackPanel Spacing="10">
                <TextBlock Text="Appearance" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <StackPanel Spacing="20">
                        <RadioButtons Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <x:String>Use system setting</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </RadioButtons>

                        <!-- Order matches ColorSchemes.All: Ledger, Frost, Forest, Terracotta. Each has a light and a dark variant. -->
                        <RadioButtons Header="Colour scheme" MaxColumns="2"
                                      SelectedIndex="{x:Bind ViewModel.SchemeIndex, Mode=TwoWay}">
                            <RadioButton AutomationProperties.Name="Ledger: warm off-white, charcoal, dusty blue, sage">
                                <StackPanel Spacing="6" Margin="0,0,24,4">
                                    <TextBlock Text="Ledger" />
                                    <Border Style="{StaticResource LedgerSwatchStripStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchLedger1Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchLedger2Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchLedger3Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchLedger4Brush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Frost: frost blue, dusty white">
                                <StackPanel Spacing="6" Margin="0,0,24,4">
                                    <TextBlock Text="Frost" />
                                    <Border Style="{StaticResource LedgerSwatchStripStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchFrost1Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchFrost2Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchFrost3Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchFrost4Brush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Forest: forest green, diorite, berry">
                                <StackPanel Spacing="6" Margin="0,0,24,4">
                                    <TextBlock Text="Forest" />
                                    <Border Style="{StaticResource LedgerSwatchStripStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchForest1Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchForest2Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchForest3Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchForest4Brush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Terracotta: terracotta, redwood, gold">
                                <StackPanel Spacing="6" Margin="0,0,24,4">
                                    <TextBlock Text="Terracotta" />
                                    <Border Style="{StaticResource LedgerSwatchStripStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchTerracotta1Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchTerracotta2Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchTerracotta3Brush}" />
                                            <Rectangle Style="{StaticResource LedgerSwatchStyle}" Fill="{StaticResource LedgerSwatchTerracotta4Brush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" Margin="0,-12,0,0"
                                   Text="Each colour scheme has a light and a dark version, chosen by the theme above. Windows high contrast overrides both." />
                        <ToggleSwitch Header="Decorative art beside pages on wide windows" IsOn="{x:Bind ViewModel.ShowSideArt, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Categories" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LedgerBodyStyle}" VerticalAlignment="Center"
                                   Text="Add, rename, group and archive the categories you use for spending, income and savings." />
                        <Button Grid.Column="1" Content="Manage categories" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ManageCategoriesCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Suggestions" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource LedgerBodyStyle}" TextWrapping="Wrap"
                                   Text="Ledger learns from your own entries, on this PC only: the usual category, account and amount for a payee, and notes you've written before. It only suggests; nothing is saved until you save it." />
                        <ToggleSwitch Header="Spot payments that repeat and suggest them as bills" IsOn="{x:Bind ViewModel.SpotRepeats, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Paycheck taxes" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <StackPanel Spacing="12">
                        <ToggleSwitch Header="I live and work in Pennsylvania" IsOn="{x:Bind ViewModel.InPennsylvania, Mode=TwoWay}" OnContent="Yes" OffContent="No" />
                        <TextBlock Style="{StaticResource LedgerSecondaryStyle}" Visibility="{x:Bind ViewModel.InPennsylvania, Mode=OneWay}"
                                   Text="Where you live sets your resident earned income tax (municipality plus school district). Paycheck estimates withhold this or your work location's rate, whichever is higher." />
                        <TextBlock Style="{StaticResource LedgerSecondaryStyle}" Visibility="{x:Bind ViewModel.OutsidePennsylvania, Mode=OneWay}"
                                   Text="Paycheck estimates include federal income tax, Social Security and Medicare only. Ledger doesn't have other states' tax tables, so your real paychecks will usually be a little lower if your state has an income tax." />
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.InPennsylvania, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Home municipality" PlaceholderText="e.g. Lancaster City" Text="{x:Bind ViewModel.HomeLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="PSD code" MaxLength="6" Text="{x:Bind ViewModel.HomePsd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Header="Resident rate (%)" InputScope="Number" Text="{x:Bind ViewModel.HomeEitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Save" Command="{x:Bind ViewModel.SaveHomeCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.HomeMessage, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.InPennsylvania, Mode=OneWay}"
                                   Text="Find your municipality's PSD code and combined resident rate on the statewide list at munstats.pa.gov (Act 32 EIT rates)." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Data" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Your data is stored only on this PC, in:" Style="{StaticResource LedgerBodyStyle}" />
                            <TextBlock Text="{x:Bind Data.DataLocation}" Style="{StaticResource LedgerSecondaryStyle}" IsTextSelectionEnabled="True" />
                            <HyperlinkButton Content="Open data folder" Padding="0" Click="OnOpenDataFolderClick" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Backups" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                                       Text="A backup is a complete copy of your data in one file. Save one somewhere other than this PC, like a USB drive or a cloud folder." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Back up now…" Click="OnBackUpClick"
                                        IsEnabled="{x:Bind IsIdle(Data.IsBusy), Mode=OneWay}" />
                                <Button Content="Restore a backup…" Click="OnRestoreClick" IsEnabled="{x:Bind IsIdle(Data.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch Header="Automatic daily backup" IsOn="{x:Bind Data.IsAutomaticOn, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                            <TextBlock Text="{x:Bind Data.LastAutomaticText, Mode=OneWay}" Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="Open backups folder" Padding="0" Click="OnOpenBackupsFolderClick" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Export" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Style="{StaticResource LedgerCaptionStyle}" TextWrapping="Wrap"
                                       Text="Take your data anywhere: transactions for a spreadsheet, or everything in a documented format other apps can read." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Export transactions (CSV)…" Click="OnExportCsvClick" IsEnabled="{x:Bind IsIdle(Data.IsBusy), Mode=OneWay}" />
                                <Button Content="Export everything (JSON)…" Click="OnExportJsonClick" IsEnabled="{x:Bind IsIdle(Data.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <ProgressRing IsActive="{x:Bind Data.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" Width="20" Height="20" />
                        <InfoBar IsOpen="{x:Bind Data.HasMessage, Mode=OneWay}" Visibility="{x:Bind Data.HasMessage, Mode=OneWay}" IsClosable="True"
                                 Severity="{x:Bind SeverityFor(Data.IsError), Mode=OneWay}"
                                 Message="{x:Bind Data.Message, Mode=OneWay}" Closed="OnMessageClosed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="About" Style="{StaticResource LedgerSectionTitleStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource LedgerCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ledger" Style="{StaticResource LedgerBodyStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource LedgerSecondaryStyle}" />
                        <TextBlock Text="Local-first personal finance. No account, no cloud, no tracking."
                                   Style="{StaticResource LedgerSecondaryStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Content="Take the welcome tour" Command="{x:Bind ViewModel.StartTourCommand}" />
                            <Button Content="Open Help" Command="{x:Bind ViewModel.OpenHelpCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
