<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour scheme "Frost": frost blue on dusty white (dark: blue-slate).
          Positive  → cool green
          Warning   → amber
          Problem   → brick red
          Accent    → frost blue
        Same keys as Ledger.xaml; see the notes there.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="#F1F4F6" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="#FBFCFD" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="#E8EDF1" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="#D8E0E7" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="#1E2630" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="#566271" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="#626E7C" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="#3D7659" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="#8A6214" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="#A9473F" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="#41698C" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="#DDEBE3" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="#DCE7F0" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="#E6E2F4" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="#F4E3D7" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="#DFE5EB" />

            <!-- Fluent accent overrides so native controls pick up the frost blue. -->
            <Color x:Key="SystemAccentColor">#4F7899</Color>
            <Color x:Key="SystemAccentColorLight1">#6C91B0</Color>
            <Color x:Key="SystemAccentColorLight2">#8DABC5</Color>
            <Color x:Key="SystemAccentColorLight3">#B2C8DB</Color>
            <Color x:Key="SystemAccentColorDark1">#41698C</Color>
            <Color x:Key="SystemAccentColorDark2">#355873</Color>
            <Color x:Key="SystemAccentColorDark3">#2A465C</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="#161B21" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="#1E242B" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="#262D35" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="#323B45" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="#E7EDF3" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="#A6B1BD" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="#8D98A4" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="#8CC2A2" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="#DDB266" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="#E68E86" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="#9DC1DF" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="#233530" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="#22303E" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="#2D2B3E" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="#3A2E29" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="#2C343E" />

            <Color x:Key="SystemAccentColor">#7FA6C8</Color>
            <Color x:Key="SystemAccentColorLight1">#9DC1DF</Color>
            <Color x:Key="SystemAccentColorLight2">#B9D4EA</Color>
            <Color x:Key="SystemAccentColorLight3">#B6D2EA</Color>
            <Color x:Key="SystemAccentColorDark1">#6A91B3</Color>
            <Color x:Key="SystemAccentColorDark2">#587B9A</Color>
            <Color x:Key="SystemAccentColorDark3">#466480</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
