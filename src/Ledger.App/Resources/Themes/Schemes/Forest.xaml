<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour scheme "Forest": forest green and diorite (pale stone grey-white), with berry as the accent.
          Positive  → clear leaf green (brighter and bluer than the forest tints)
          Warning   → amber
          Problem   → vermilion red, pushed toward orange so it never reads as the berry accent
          Accent    → berry
        Same keys as Ledger.xaml; see the notes there.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="#EFEFEB" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="#FAFAF7" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="#E6E7E2" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="#D7D8D1" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="#1C2A22" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="#525F58" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="#646F69" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="#2D7650" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="#8A6212" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="#B0442A" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="#8A3A5E" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="#DAE8DB" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="#DEE6E0" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="#F0DFE8" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="#F3E3D1" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="#DFE0DA" />

            <!-- Fluent accent overrides so native controls pick up the berry. -->
            <Color x:Key="SystemAccentColor">#94466A</Color>
            <Color x:Key="SystemAccentColorLight1">#A85F80</Color>
            <Color x:Key="SystemAccentColorLight2">#BF7F9B</Color>
            <Color x:Key="SystemAccentColorLight3">#D6A7BB</Color>
            <Color x:Key="SystemAccentColorDark1">#8A3A5E</Color>
            <Color x:Key="SystemAccentColorDark2">#72304E</Color>
            <Color x:Key="SystemAccentColorDark3">#5A263E</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="#141B17" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="#1B241F" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="#232D27" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="#303B34" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="#E8ECE7" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="#A8B2AA" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="#8F9A92" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="#86C49E" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="#DDB266" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="#F08E72" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="#DB9DB8" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="#21372A" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="#24322A" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="#3A2534" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="#3A2E25" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="#2B352F" />

            <Color x:Key="SystemAccentColor">#C77399</Color>
            <Color x:Key="SystemAccentColorLight1">#CF8FAC</Color>
            <Color x:Key="SystemAccentColorLight2">#D6A3BA</Color>
            <Color x:Key="SystemAccentColorLight3">#E8B7CC</Color>
            <Color x:Key="SystemAccentColorDark1">#B05F85</Color>
            <Color x:Key="SystemAccentColorDark2">#944D6F</Color>
            <Color x:Key="SystemAccentColorDark3">#783D59</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LedgerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerSurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerPositiveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerNegativeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LedgerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LedgerSageSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerBlueSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerLavenderSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerPeachSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LedgerTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
