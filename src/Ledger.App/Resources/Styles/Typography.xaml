<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="LedgerDisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="LedgerTextFont">Segoe UI Variable Text</FontFamily>

    <Style x:Key="LedgerTextBaseStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LedgerTextFont}" />
        <Setter Property="Foreground" Value="{ThemeResource LedgerTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The large headline figure on a page (e.g. "Available"). -->
    <Style x:Key="LedgerDisplayAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontFamily" Value="{StaticResource LedgerDisplayFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="LedgerPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontFamily" Value="{StaticResource LedgerDisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LedgerSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontFamily" Value="{StaticResource LedgerDisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Small label above a figure, e.g. "ACTUAL BALANCE". -->
    <Style x:Key="LedgerEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource LedgerTextSecondaryBrush}" />
    </Style>

    <Style x:Key="LedgerBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="LedgerSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerBodyStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LedgerTextSecondaryBrush}" />
    </Style>

    <Style x:Key="LedgerCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource LedgerTextBaseStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource LedgerTextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
