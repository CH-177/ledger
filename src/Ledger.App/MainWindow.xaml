<Window
    x:Class="Ledger.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ledger.App.Controls"
    Title="Ledger">

    <Grid x:Name="RootGrid" Background="{ThemeResource LedgerBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag region with the app name. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4" Background="{ThemeResource LedgerAccentBrush}">
                    <TextBlock Text="L" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource LedgerSurfaceBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Ledger" Style="{StaticResource LedgerCaptionStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource LedgerTextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="232"
            IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}"
            ItemInvoked="OnNavigationItemInvoked">

            <NavigationView.Resources>
                <!-- Let the warm window background show through; separation comes from spacing, not chrome. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Transactions" Tag="Transactions">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Budget" Tag="Budget">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Income" Tag="Income">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE821;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bills" Tag="Bills">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Goals" Tag="Goals">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="What if?" Tag="Plan">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA80;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Accounts" Tag="Accounts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Reports" Tag="Reports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Help" Tag="Help" ToolTipService.ToolTip="Help (F1)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ContentArea" SizeChanged="OnContentAreaSizeChanged">
                <!-- Decoration in the space right of the page column (LedgerContentMaxWidth); behind the
                     page, never clickable, and only when there's room. -->
                <controls:SideArt x:Name="SideArt" HorizontalAlignment="Right" Visibility="Collapsed" />
                <Frame x:Name="ContentFrame" />
            </Grid>
        </NavigationView>

        <!-- The welcome tour: one tip, moved from rail item to rail item (see WelcomeTour). -->
        <TeachingTip x:Name="TourTip" Grid.Row="1" IsLightDismissEnabled="False" PreferredPlacement="Right"
                     ActionButtonStyle="{StaticResource AccentButtonStyle}"
                     ActionButtonClick="OnTourActionClick" Closed="OnTourClosed">
            <StackPanel Spacing="12" Margin="0,4,0,0">
                <TextBlock x:Name="TourText" TextWrapping="Wrap" Style="{StaticResource LedgerBodyStyle}" />
                <Grid>
                    <TextBlock x:Name="TourProgress" Style="{StaticResource LedgerCaptionStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="TourBack" Content="Back" HorizontalAlignment="Right" Padding="8,4" Click="OnTourBackClick" />
                </Grid>
            </StackPanel>
        </TeachingTip>

        <!-- First launch: filled with an OnboardingView only when there are no accounts yet. -->
        <ContentControl x:Name="OnboardingHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsOnboarding, Mode=OneWay}" />

        <!-- Opening the database. -->
        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.Name="Opening your data" />

        <!-- Database could not be opened. No technical details are shown here; they go to the local log. -->
        <Grid Grid.Row="1" Background="{ThemeResource LedgerBackgroundBrush}"
              Visibility="{x:Bind ViewModel.HasFailed, Mode=OneWay}">
            <Border Style="{StaticResource LedgerCardStyle}" MaxWidth="440" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ledger couldn't open your data." Style="{StaticResource LedgerSectionTitleStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource LedgerSecondaryStyle}"
                               Text="Your existing data has not been changed. If this keeps happening, make sure no other copy of Ledger is running." />
                    <Button Content="Try Again" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0"
                            Click="OnRetryClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
